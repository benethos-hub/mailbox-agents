# Settings of benethos-mailbox-agent, see docs/specs/configuration.md.
#
# One process runs one agent, so one file describes one agent. Copy this
# file to .env beside it, or set the same names in the environment. A
# secret may be given as a file instead: add _FILE to its name and name
# the file, as a container mounts it. A secret given directly wins.

# The mailbox service and this agent's token.
MAILBOX_AGENT_SERVICE_URL=https://mailbox.example.test
MAILBOX_AGENT_SERVICE_TOKEN=
# MAILBOX_AGENT_SERVICE_TOKEN_FILE=/run/secrets/service_token
# http to another machine carries the token unencrypted, so it is refused
# unless allowed here, as between two containers on one network.
MAILBOX_AGENT_SERVICE_ALLOW_HTTP=false

# The model gateway and this agent's key.
MAILBOX_AGENT_GATEWAY_URL=https://gateway.example.test/v1
# http to another machine carries the key and the mail unencrypted, so it
# is refused unless allowed here, as between two containers on one network.
MAILBOX_AGENT_GATEWAY_ALLOW_HTTP=false
MAILBOX_AGENT_GATEWAY_KEY=
# MAILBOX_AGENT_GATEWAY_KEY_FILE=/run/secrets/gateway_key
# How long one model call may take, in seconds.
MAILBOX_AGENT_GATEWAY_TIMEOUT_SECONDS=120

# The alias the gateway resolves to a model.
MAILBOX_AGENT_MODEL=mail-classifier

# The accounts to work on, comma separated. All the user may read when unset.
# MAILBOX_AGENT_ACCOUNTS=

# shadow, keyword or full. shadow when unset.
MAILBOX_AGENT_STAGE=shadow

# The keyword the agent sets. Each agent has its own default:
# invoice, awaiting-reply, inquiry.
# MAILBOX_AGENT_KEYWORD=

# How often the feed is read and the clock asked, in seconds.
MAILBOX_AGENT_POLL_SECONDS=60
MAILBOX_AGENT_TICK_SECONDS=900

# Refused answers of the model before a message is given up as failed.
MAILBOX_AGENT_MAX_ATTEMPTS=5
# The longest wait between two attempts, in seconds.
MAILBOX_AGENT_BACKOFF_CEILING_SECONDS=3600
# The days backfill runs over when the feed state has expired.
MAILBOX_AGENT_BACKFILL_DAYS=7

# Where the state file lives.
MAILBOX_AGENT_DATA_DIR=data

# Keep the full request and answer of each model call this many days.
# 0 keeps none.
MAILBOX_AGENT_PROMPT_RETENTION_DAYS=0

# The port of the metrics endpoint. 0 serves none, the containers use 9464.
MAILBOX_AGENT_METRICS_PORT=0

# DEBUG, INFO, WARNING or ERROR.
MAILBOX_AGENT_LOG_LEVEL=INFO

# --- invoices, docs/specs/agents/invoices.md ---
# The parent folder of the supplier folders.
# MAILBOX_AGENT_INVOICES_FOLDER=Invoices
# The supplier list, JSON, made after suppliers.example.json beside this file.
# MAILBOX_AGENT_INVOICES_SUPPLIERS_FILE=config/benethos-mailbox-agent/suppliers.json

# --- awaiting_reply, docs/specs/agents/awaiting_reply.md ---
# Working days, Monday to Friday, until an open item is due.
# MAILBOX_AGENT_REPLY_DAYS=3

# --- inquiries, docs/specs/agents/inquiries.md ---
# Sender domains and phrases the baseline knows besides its own, made
# after inquiries.example.json beside this file. Optional.
# MAILBOX_AGENT_INQUIRIES_PATTERNS_FILE=config/benethos-mailbox-agent/inquiries.json
