# Settings of the agent awaiting_reply in operation, see docs/specs/configuration.md.
# Copy to .env beside this file. The token and the key are files under
# ../../secrets/awaiting_reply/, named service_token and gateway_key, readable by
# uid 10001. compose.yaml names them, so they are not set here.

# The mailbox service, as the container reaches it. http only between two
# containers on one network, which SERVICE_ALLOW_HTTP then allows.
MAILBOX_AGENT_SERVICE_URL=https://mailbox.example.test
# MAILBOX_AGENT_SERVICE_ALLOW_HTTP=false

# The accounts to work on, comma separated. All the user may read when unset.
# MAILBOX_AGENT_ACCOUNTS=

# shadow, keyword or full. A new agent starts in shadow, and so does one
# whose prompt or model changed until the evaluation was run again.
MAILBOX_AGENT_STAGE=shadow

# The model gateway and the alias it resolves.
MAILBOX_AGENT_GATEWAY_URL=https://gateway.example.test/v1
# http only between two containers on one network, which this allows.
# MAILBOX_AGENT_GATEWAY_ALLOW_HTTP=false
MAILBOX_AGENT_MODEL=mail-classifier

# Working days, Monday to Friday, until a sent message without an answer
# gets the keyword, and how often the clock is asked.
MAILBOX_AGENT_REPLY_DAYS=3
MAILBOX_AGENT_TICK_SECONDS=900
